# MediTrack Backend Environment Configuration

PORT=5001
NODE_ENV=development

# MySQL Database Configuration (MySQL Workbench / Local Server)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=meditrack_db
DB_PORT=3306

# Authentication Secrets
JWT_SECRET=meditrack_super_secret_jwt_key_2026!
JWT_EXPIRES_IN=24h

# CORS Configuration
CLIENT_URL=http://localhost:5173

# SMTP email (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MediTrack <your_email@gmail.com>
ALERT_EMAIL=pharmacy_owner@example.com
